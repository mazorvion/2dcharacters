---
/**
 * The Double · exploded-view scroll story.
 * Generated by `npm run build:astro` in the double-story repo from src/content.ts: edit the copy there
 * and rebuild rather than editing this file.
 *
 *   <DoubleStory />                        brand fonts bundled, smooth scroll on
 *   <DoubleStory fonts={false} />          the page already loads Funnel Display, Geist, Geist Mono, Newsreader
 *   <DoubleStory smoothScroll={false} />   the page already runs Lenis (or another smooth scroller)
 *
 * Needs public/double-story/ (shipped next to this file). Works with Astro view transitions.
 */
interface Props {
  /** Load the bundled brand fonts. Default true; pass false where the page already has them. */
  fonts?: boolean;
  /** Lenis smooth scrolling while the story runs. Default true. */
  smoothScroll?: boolean;
  /** URL the public/double-story/ folder is served from. Default: <site base>/double-story. */
  assets?: string;
}
const {
  fonts = true,
  smoothScroll = true,
  assets = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/double-story`,
} = Astro.props;
const V = {"js":"43bd4a3b06","css":"309f0c8f00","fonts":"5b62724773"};
const MARKUP = "<section id=\"double-story\" class=\"story\" data-mode=\"static\" data-ch=\"hero\" aria-labelledby=\"double-story-title\">\n  <a class=\"skip\" href=\"#double-story-end\">Skip</a>\n  <div class=\"stage\">\n    <div class=\"paper\" aria-hidden=\"true\"></div>\n    <div class=\"spot\" aria-hidden=\"true\"></div>\n    \n    <canvas class=\"gl\" aria-hidden=\"true\"></canvas>\n    <svg class=\"lines\" aria-hidden=\"true\"></svg>\n    <div class=\"overlay\" aria-hidden=\"true\"></div>\n    <div class=\"blueprint-frame\" aria-hidden=\"true\">\n    <i class=\"mark t\"></i><i class=\"mark b\"></i><i class=\"mark l\"></i><i class=\"mark r\"></i>\n    <p class=\"diagram-title\"><b>THE DOUBLE</b> — EXPLODED VIEW ASSEMBLY DIAGRAM</p>\n  </div>\n  </div>\n  <div class=\"chapters\">\n    <article class=\"chapter\" data-ch=\"exploded\" data-stage=\"center\" style=\"--len:170\"><div class=\"copy\">\n      <div class=\"head\">\n        <p class=\"eyebrow\"><i class=\"sq\" style=\"background:var(--cobalt)\"></i>The Double · Exploded view</p>\n        <h2 class=\"title\" id=\"double-story-title\"><span class=\"w\"><span class=\"wi\">Every</span></span> <span class=\"w\"><span class=\"wi\">Double</span></span> <span class=\"w\"><span class=\"wi\">starts</span></span> <em><span class=\"w\"><span class=\"wi\">in</span></span> <span class=\"w\"><span class=\"wi\">pieces.</span></span></em></h2>\n        \n      </div>\n      \n    </div></article>\n    <article class=\"chapter\" data-ch=\"assemble\" data-stage=\"center\" style=\"--len:190\"><div class=\"copy\">\n      <div class=\"head\">\n        <p class=\"eyebrow\"><i class=\"sq\" style=\"background:var(--lime-edge)\"></i>Assembly</p>\n        <h3 class=\"title\"><span class=\"w\"><span class=\"wi\">Piece</span></span> <span class=\"w\"><span class=\"wi\">by</span></span> <span class=\"w\"><span class=\"wi\">piece,</span></span> <em><span class=\"w\"><span class=\"wi\">it</span></span> <span class=\"w\"><span class=\"wi\">comes</span></span> <span class=\"w\"><span class=\"wi\">together.</span></span></em></h3>\n        \n      </div>\n      \n    </div></article>\n    <article class=\"chapter\" data-ch=\"speaking\" data-stage=\"left\" style=\"--len:150\"><div class=\"copy\">\n      <div class=\"head\">\n        <p class=\"eyebrow\"><i class=\"sq\" style=\"background:var(--bubblegum)\"></i>01 · Speaking</p>\n        <h3 class=\"title\"><span class=\"w\"><span class=\"wi\">Talks</span></span> <span class=\"w\"><span class=\"wi\">in</span></span> <em><span class=\"w\"><span class=\"wi\">your</span></span> <span class=\"w\"><span class=\"wi\">voice.</span></span></em></h3>\n        \n      </div>\n      <div class=\"demo\" aria-hidden=\"true\"></div>\n    </div></article>\n    <article class=\"chapter\" data-ch=\"hearing\" data-stage=\"right\" style=\"--len:140\"><div class=\"copy\">\n      <div class=\"head\">\n        <p class=\"eyebrow\"><i class=\"sq\" style=\"background:var(--lime-edge)\"></i>02 · Hearing</p>\n        <h3 class=\"title\"><span class=\"w\"><span class=\"wi\">Listens</span></span> <em><span class=\"w\"><span class=\"wi\">in</span></span> <span class=\"w\"><span class=\"wi\">real</span></span> <span class=\"w\"><span class=\"wi\">time.</span></span></em></h3>\n        \n      </div>\n      <div class=\"demo\" aria-hidden=\"true\"></div>\n    </div></article>\n    <article class=\"chapter\" data-ch=\"thinking\" data-stage=\"left\" style=\"--len:140\"><div class=\"copy\">\n      <div class=\"head\">\n        <p class=\"eyebrow\"><i class=\"sq\" style=\"background:var(--grape)\"></i>03 · Thinking</p>\n        <h3 class=\"title\"><span class=\"w\"><span class=\"wi\">Thinks</span></span> <em><span class=\"w\"><span class=\"wi\">before</span></span> <span class=\"w\"><span class=\"wi\">it</span></span> <span class=\"w\"><span class=\"wi\">answers.</span></span></em></h3>\n        \n      </div>\n      <div class=\"demo\" aria-hidden=\"true\"></div>\n    </div></article>\n    <article class=\"chapter\" data-ch=\"knowledge\" data-stage=\"right\" style=\"--len:150\"><div class=\"copy\">\n      <div class=\"head\">\n        <p class=\"eyebrow\"><i class=\"sq\" style=\"background:var(--amber)\"></i>04 · Knowledge</p>\n        <h3 class=\"title\"><span class=\"w\"><span class=\"wi\">Learns</span></span> <span class=\"w\"><span class=\"wi\">from</span></span> <em><span class=\"w\"><span class=\"wi\">what</span></span> <span class=\"w\"><span class=\"wi\">you</span></span> <span class=\"w\"><span class=\"wi\">know.</span></span></em></h3>\n        \n      </div>\n      <div class=\"demo\" aria-hidden=\"true\"></div>\n    </div></article>\n    <article class=\"chapter\" data-ch=\"acting\" data-stage=\"left\" style=\"--len:160\"><div class=\"copy\">\n      <div class=\"head\">\n        <p class=\"eyebrow\"><i class=\"sq\" style=\"background:var(--tangerine)\"></i>05 · Acting</p>\n        <h3 class=\"title\"><span class=\"w\"><span class=\"wi\">Then</span></span> <span class=\"w\"><span class=\"wi\">it</span></span> <em><span class=\"w\"><span class=\"wi\">gets</span></span> <span class=\"w\"><span class=\"wi\">things</span></span> <span class=\"w\"><span class=\"wi\">done.</span></span></em></h3>\n        \n      </div>\n      <div class=\"demo\" aria-hidden=\"true\"></div>\n    </div></article>\n    <article class=\"chapter\" data-ch=\"assembled\" data-stage=\"center\" style=\"--len:190\"><div class=\"copy\">\n      <div class=\"head\">\n        <p class=\"eyebrow\"><i class=\"sq\" style=\"background:var(--lime-edge)\"></i>Ready when you are</p>\n        <h3 class=\"title\"><span class=\"w\"><span class=\"wi\">Meet</span></span> <em><span class=\"w\"><span class=\"wi\">your</span></span> <span class=\"w\"><span class=\"wi\">Double.</span></span></em></h3>\n        <div class=\"cta\">\n        <a class=\"btn btn-primary\" href=\"https://thedouble.ai/auth/signup\">Build your Double</a>\n        <a class=\"btn btn-ghost\" href=\"https://thedouble.ai/demo\">Book a demo</a>\n      </div>\n      </div>\n      \n    </div></article>\n  </div>\n  <span id=\"double-story-end\"></span>\n</section>";
const html = smoothScroll ? MARKUP : MARKUP.replace('<section id="double-story"', '<section id="double-story" data-smooth-scroll="false"');
---
{fonts && <link rel="stylesheet" href={`${assets}/fonts.css?v=${V.fonts}`} />}
<link rel="stylesheet" href={`${assets}/double-story.css?v=${V.css}`} />
<Fragment set:html={html} />
<script is:inline type="module" src={`${assets}/double-story.js?v=${V.js}`}></script>
